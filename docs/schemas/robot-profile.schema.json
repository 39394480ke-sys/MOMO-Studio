{
  "$defs": {
    "CalibrationOperatingMode": {
      "enum": [
        "MULTI_TURN",
        "SINGLE_TURN"
      ],
      "title": "CalibrationOperatingMode",
      "type": "string"
    },
    "DomainUnit": {
      "description": "Canonical persisted units at the domain/UI boundary.",
      "enum": [
        "deg",
        "mm"
      ],
      "title": "DomainUnit",
      "type": "string"
    },
    "JointDefinition": {
      "additionalProperties": false,
      "description": "One joint's canonical domain limits and eventual hardware mapping slot.",
      "properties": {
        "direction": {
          "default": 1,
          "enum": [
            -1,
            1
          ],
          "title": "Direction",
          "type": "integer"
        },
        "domain_unit": {
          "$ref": "#/$defs/DomainUnit"
        },
        "hardware_mapping_placeholder": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Mapping Placeholder"
        },
        "home": {
          "title": "Home",
          "type": "number"
        },
        "home_present_raw": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Present Raw"
        },
        "joint_id": {
          "pattern": "^j[1-9][0-9]*$",
          "title": "Joint Id",
          "type": "string"
        },
        "joint_type": {
          "$ref": "#/$defs/JointType"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "motor_degrees_per_domain_unit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motor Degrees Per Domain Unit"
        },
        "operating_mode": {
          "$ref": "#/$defs/CalibrationOperatingMode",
          "default": "MULTI_TURN"
        },
        "raw_bounds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Bounds"
        },
        "raw_counts_per_motor_revolution": {
          "default": 4096.0,
          "exclusiveMinimum": 0,
          "title": "Raw Counts Per Motor Revolution",
          "type": "number"
        },
        "raw_reachable": {
          "default": false,
          "title": "Raw Reachable",
          "type": "boolean"
        },
        "servo_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Servo Id"
        }
      },
      "required": [
        "joint_id",
        "joint_type",
        "domain_unit",
        "minimum",
        "maximum",
        "home"
      ],
      "title": "JointDefinition",
      "type": "object"
    },
    "JointType": {
      "enum": [
        "REVOLUTE",
        "PRISMATIC"
      ],
      "title": "JointType",
      "type": "string"
    },
    "ProfileVerificationStatus": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED_FOR_DRY_RUN",
        "VERIFIED_FOR_REAL"
      ],
      "title": "ProfileVerificationStatus",
      "type": "string"
    },
    "RobotVariant": {
      "description": "A product variant, not a software version.",
      "enum": [
        "V1",
        "V2"
      ],
      "title": "RobotVariant",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned product profile with an explicit, ordered joint set.",
  "properties": {
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "enabled_joints": {
      "items": {
        "pattern": "^j[1-9][0-9]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Enabled Joints",
      "type": "array"
    },
    "has_linear_rail": {
      "title": "Has Linear Rail",
      "type": "boolean"
    },
    "joint_definitions": {
      "items": {
        "$ref": "#/$defs/JointDefinition"
      },
      "minItems": 1,
      "title": "Joint Definitions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "default": "momo-stage-2",
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_revision": {
      "default": "stage-2",
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "tcp_link": {
      "minLength": 1,
      "title": "Tcp Link",
      "type": "string"
    },
    "template": {
      "default": true,
      "title": "Template",
      "type": "boolean"
    },
    "urdf_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Urdf Reference"
    },
    "variant": {
      "$ref": "#/$defs/RobotVariant"
    },
    "verification_status": {
      "$ref": "#/$defs/ProfileVerificationStatus",
      "default": "VERIFIED_FOR_DRY_RUN"
    }
  },
  "required": [
    "variant",
    "display_name",
    "has_linear_rail",
    "enabled_joints",
    "joint_definitions",
    "urdf_reference",
    "tcp_link"
  ],
  "title": "RobotProfile",
  "type": "object"
}
