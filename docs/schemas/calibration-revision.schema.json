{
  "$defs": {
    "CalibrationDocument": {
      "additionalProperties": false,
      "description": "Versioned calibration keyed to an exact variant and profile fingerprint.",
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "joints": {
          "items": {
            "$ref": "#/$defs/CalibrationJoint"
          },
          "minItems": 1,
          "title": "Joints",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "profile_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Fingerprint",
          "type": "string"
        },
        "robot_variant": {
          "$ref": "#/$defs/RobotVariant"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "template": {
          "title": "Template",
          "type": "boolean"
        }
      },
      "required": [
        "robot_variant",
        "profile_fingerprint",
        "template",
        "joints"
      ],
      "title": "CalibrationDocument",
      "type": "object"
    },
    "CalibrationJoint": {
      "additionalProperties": false,
      "description": "One joint's hardware-local reference without joint-name assumptions.",
      "properties": {
        "direction": {
          "title": "Direction",
          "type": "integer"
        },
        "home_present_raw": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Present Raw"
        },
        "joint_id": {
          "pattern": "^j[1-9][0-9]*$",
          "title": "Joint Id",
          "type": "string"
        },
        "operating_mode": {
          "$ref": "#/$defs/CalibrationOperatingMode"
        },
        "phase": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "raw_bounds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Bounds"
        },
        "servo_id": {
          "minimum": 1,
          "title": "Servo Id",
          "type": "integer"
        }
      },
      "required": [
        "joint_id",
        "servo_id",
        "operating_mode",
        "direction"
      ],
      "title": "CalibrationJoint",
      "type": "object"
    },
    "CalibrationOperatingMode": {
      "enum": [
        "MULTI_TURN",
        "SINGLE_TURN"
      ],
      "title": "CalibrationOperatingMode",
      "type": "string"
    },
    "CalibrationWorkflowSource": {
      "enum": [
        "EXISTING_REAL",
        "EXPLICIT_LEGACY_IMPORT"
      ],
      "title": "CalibrationWorkflowSource",
      "type": "string"
    },
    "RobotVariant": {
      "description": "A product variant, not a software version.",
      "enum": [
        "V1",
        "V2"
      ],
      "title": "RobotVariant",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Forward-only persisted calibration revision with exact content identity.",
  "properties": {
    "calibration": {
      "$ref": "#/$defs/CalibrationDocument"
    },
    "calibration_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Calibration Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "previous_calibration_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Calibration Fingerprint"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CalibrationWorkflowSource"
    }
  },
  "required": [
    "revision",
    "calibration_fingerprint",
    "source",
    "calibration",
    "created_at"
  ],
  "title": "CalibrationRevisionRecord",
  "type": "object"
}
